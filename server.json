{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mirastacklabs-ai/mirafleet",
  "description": "Orchestrate fleets of servers from an MCP client through a central mirafleet server.",
  "repository": {
    "url": "https://github.com/mirastacklabs-ai/mirafleet",
    "source": "github"
  },
  "version": "0.6.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mirastacklabs/mirafleet",
      "version": "0.6.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
