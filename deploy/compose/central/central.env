# TEMPLATE, not read by Compose. compose.yaml reads the untracked, gitignored central.env.local
# next to it (optional). Copy settings from here into that file, and create it private:
#   umask 077; touch central.env.local     # or: chmod 600 central.env.local
#
# Credential store key. Generate it into central.env.local:
#   (umask 077; docker run --rm docker.io/mirastack/mirafleet:0.6.0 central keygen >> central.env.local)
# Losing the key loses every stored credential: back it up apart from the data volume.
#MIRAFLEET_SECRETS_KEY=
# Optional PEM file of a corporate CA (mount it read-only into the container), needed only for
# GitLab token self-rotation; central then also needs outbound HTTPS to GitLab.
#MIRAFLEET_CORPORATE_CA_FILE=
