{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mirafleet.js", "mcp", "hook", "claude-code", "session-start"]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mirafleet.js", "mcp", "hook", "claude-code", "session-end"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_mirafleet_mirafleet__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mirafleet.js", "mcp", "hook", "claude-code", "pre-tool-use"]
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|Grep|Glob|LS|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mirafleet.js", "mcp", "hook", "claude-code", "pre-tool-use"]
          }
        ]
      }
    ]
  }
}
