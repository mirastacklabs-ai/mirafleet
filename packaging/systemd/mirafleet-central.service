[Unit]
Description=mirafleet central server
Documentation=https://github.com/mirastacklabs-ai/mirafleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirafleet
Group=mirafleet
EnvironmentFile=/etc/mirafleet/central.env
# Idempotent: creates the host key, registration secret and database on first start only.
ExecStartPre=/usr/bin/mirafleet central init -data /var/lib/mirafleet/central
ExecStart=/usr/bin/mirafleet central run -data /var/lib/mirafleet/central -listen ${MIRAFLEET_LISTEN} $MIRAFLEET_CENTRAL_ARGS
Restart=on-failure
RestartSec=2s
UMask=0077

# Hardening: strict. Writable: the data dir only (database, backups, GUI certificate,
# setup-token file, admin socket). A port below 1024 needs a drop-in that sets
# AmbientCapabilities=CAP_NET_BIND_SERVICE and CapabilityBoundingSet=CAP_NET_BIND_SERVICE.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mirafleet/central
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
