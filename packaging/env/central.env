# /etc/mirafleet/central.env - read by systemd as root before mirafleet-central.service
# drops to the mirafleet user. Mode 0600 root: keep it that way.
# Not enabled on install: `systemctl enable --now mirafleet-central`.
#
# Firewall: port 2222 must be reachable from runners and operators. The Admin GUI listens
# on ALL interfaces (0.0.0.0:8443, self-signed certificate) by default, so allow 8443 only
# from admins' networks, or bind it to loopback and use `ssh -L 8443:127.0.0.1:8443 host`.
# Central needs no outbound access. The packages do not change the firewall.
#
# First GUI login: the journal shows the certificate fingerprint and the path of the one-time
# setup token, /var/lib/mirafleet/central/gui/setup-token (read it with
# `sudo -u mirafleet cat` on that path). Lost token or password:
# `sudo -u mirafleet mirafleet central gui reset-admin`.

# SSH listen address for runners and operators (a port below 1024 needs a systemd drop-in).
MIRAFLEET_LISTEN=0.0.0.0:2222

# Extra `mirafleet central run` flags, split on whitespace (no quoting). Admin GUI flags:
#   -gui-listen ADDR   default 0.0.0.0:8443 (self-signed); 127.0.0.1:8443 or off to restrict
#   -gui-cert FILE -gui-key FILE   your own certificate instead of the self-signed one
#   -gui-host NAME,... names admins type to reach the GUI (added to the allowed Host set)
#   -advertise ADDR    address shown to runners and operators
# Examples (uncomment one, keep a single MIRAFLEET_CENTRAL_ARGS line):
#MIRAFLEET_CENTRAL_ARGS=-gui-listen 127.0.0.1:8443
#MIRAFLEET_CENTRAL_ARGS=-gui-listen off
#MIRAFLEET_CENTRAL_ARGS=-gui-cert /etc/mirafleet/gui.crt -gui-key /etc/mirafleet/gui.key -gui-host central.example.org
MIRAFLEET_CENTRAL_ARGS=

# Credential store key (M7). Generate with `sudo mirafleet central keygen | sudo tee -a
# /etc/mirafleet/central.env`, which appends the whole MIRAFLEET_SECRETS_KEY=... line. Losing
# the key loses every stored credential: back it up apart from the data dir. Keep this file
# mode 0600 root.
#MIRAFLEET_SECRETS_KEY=
# Optional PEM file of a corporate CA, needed only for GitLab token self-rotation (central then
# also needs outbound HTTPS to GitLab).
#MIRAFLEET_CORPORATE_CA_FILE=
